# ---------------------------------------------------------------------------
# ComfyUI Uncensored — repository ignore rules
# Source of truth is the Python modules + ComfyUI_Uncensored.spec.
# Everything below is machine-local, generated, or huge.
# ---------------------------------------------------------------------------

# --- Python / tooling caches ---
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.venv/
venv/
env/

# --- Build + deploy artifacts ---
build/
dist/
_last_good/
_last_good_glass/
ComfyUIX/
backups/
*.exe
*.zip
*.7z

# Generated filler blob (build_exe.py writes os.urandom(125MB) to inflate bundle)
assets/bundle_payload.bin
ComfyUIX/_internal/assets/bundle_payload.bin

# --- The ComfyUI portable engine (tens of GB, user-supplied, never committed) ---
ComfyUI_windows_portable/

# --- Model weights ---
*.safetensors
*.ckpt
*.gguf
*.pth
*.bin
models_archive/

# --- Runtime output / scratch ---
output/
input/
logs/
diagnostics/
audit_temp/
*.log
*.tmp
*.bak
*.orig
nul
*.png
*.jpg
*.jpeg
*.mp4
*.webp

# --- Text scratch: ignore by default, allow the two real manifests ---
*.txt
!requirements.txt
!requirements.lock.txt

# --- Agent / assistant workspaces & scratch planning docs (never app source) ---
.agent_workspace/
.hermes/
.gemini/
.geminiignore
GEMINI.md
AGENTS.md
CLAUDE.md
docs/AGENT/
TAB_DEBUG_PLAN.md
PROJECT_REFERENCE.md

# --- Retired prototypes / dead trees ---
spark_plan_qt6/
qt_app/

# --- Machine-local user config (may contain local paths) ---
# NOTE: config.json IS tracked as the portable default template;
# the app writes user overrides next to the EXE at runtime.
app_config.local.json
